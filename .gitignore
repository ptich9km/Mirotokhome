# Godot 4+ specific ignores
.godot/
*.godot/

# Temp/agent scratch
.qwen/
.agents/
.kodik/
wip/

# OS generated files
.DS_Store
Thumbs.db

# Godot Mono (if using C#)
.mono/
*.sln
*.csproj

# Export files
*.pck
*.exe
*.app
*.x86_64
*.wasm
*.html

# IDE
.vscode/
.idea/
*.import

# Python (скрипты-генераторы ассетов в tests/)
__pycache__/
*.pyc

# Генерируемый рендер карты для визуального контроля (tests/render_alm_png.gd).
# В коммите лежал устаревший кусок 4 КБ, а текущий рендер 128x128 = 14 МБ.
# Это выход dev-инструмента, а не ассет: пересоздаётся одной командой.
assets/maps/gen/gen_smart_01.png
assets/maps/gen/gen_smart_01.png.import

# "Превью рига" (tests/rig_render_preview.gd) — выход отладочного рендера,
# артефакт, а не контент. Аналогично контактным листам ниже.
rig_preview.png
rig_preview.png.import

# Контактный лист частей рига (tests/extract_rig_parts.py --preview) — выход
# dev-инструмента, пересоздаётся одной командой.
assets/units/rig/rig_hero_atlas/_parts_preview.png
assets/units/rig/rig_hero_atlas/_parts_preview.png.import

# Контактные листы ассетов - выход dev-инструмента для визуального контроля
# (tests/extract_chatgpt_armor.py --sheet, tests/extract_chatgpt_weapons2.py --sheet,
#  tests/gen_faction_armor_tint.py --sheet, tests/gen_faction_weapon_tint.py --sheet).
# Это не ассет игры: пересоздаётся одной командой, в Godot импортировать не нужно.
assets/items/base/_contact_sheet.png
assets/items/base/_contact_sheet.png.import
assets/items/base_w/_contact_sheet.png
assets/items/base_w/_contact_sheet.png.import
assets/items/faction/*/_contact_sheet.png
assets/items/faction/*/_contact_sheet.png.import
assets/items/faction_w/*/_contact_sheet.png
assets/items/faction_w/*/_contact_sheet.png.import

# Служебные рендеры импорта предметов (tests/gen_items_atlas_kodik.py,
# tests/slice_items_atlas.py) и варианты дроп-иконок
# (tests/gen_loot_icons_derived.py) — выход dev-инструмента, пересоздаётся
# одной командой; в git уходят summary.json (манифест нарезки); сами листы
# ИИ-арта и контакт-листы не отслеживаются — см. блок про import/*.png ниже.
import/items_atlas/_check_*
import/items_atlas/_dbg_*
import/items_atlas/_sliced/
import/loot_icons_derived/
## Выход tests/gen_broken_overlay.py: варианты иконки «сломано», контакт-листы
## и сравнения. Пересоздаётся одной командой; в git уходят установленные иконки.
import/broken_overlay/

# Raw AI art source sheets — the inputs of tests/gen_*.py and tests/extract_*.py.
# The game only loads the sliced sprites in assets/, so these sheets are dev-only
# and cost ~0.5 GB in every clone. Kept in git: manifests and slicing notes
# (*.json / *.md / *.properties) that document the atlas layout. The files stay
# on disk, they are simply no longer tracked.
import/*.png
import/**/*.png

# Контакт-листы курсора и диагностика нарезки (tests/extract_cursor_frames.py,
# tests/gen_cursor_strip.py) — выход dev-инструмента, пересоздаётся одной командой.
assets/ui/cursor/*_contact_sheet*.png
import/Cursor/compare_*
import/Cursor/_proto_*.png
import/Cursor/*_preview.png

# 3D sources for the sprite pipeline (tests/render_3d_frames.py): the artist
# sends .blend/.glb, the game only needs the rendered PNG frames.
# Sources stay outside git (they are hundreds of MB); keep a copy on disk/cloud.
import/3d_src/
*.blend
*.blend1

# API keys (never commit)
.kodik_key
*.kodik_key

# Скачанные исходники звуков (CC0-паки); в репо идут только выбранные файлы
import/audio_src/

# Ключ KodikRouter для аудио-моделей (в git не идёт)
.kodik_audio_key


# Export builds (butler pushes these to itch.io)
/build/

