      "key": "voice.npc.merchant.4",
      "role": "merchant",
      "races": [
        "human",
        "ork",
        "necro",
        "druid"
      ],
      "text": "Не торопись: хорошая броня окупается после второй вылазки.",
      "subtitle": "Не торопись: хорошая броня окупается после второй вылазки.",
      "text_en": "No hurry. Good armour pays for itself after the second trip."
